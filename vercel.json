{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/crypto.ts": { "maxDuration": 30 }
  },
  "routes": [
    { "src": "/api(?:/.*)?", "dest": "/api/crypto" },
    { "handle": "filesystem" },
    { "src": "/assets(?:/.*)?", "status": 404 },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
